# Copy to .env. The browser never receives these keys.
OPENAI_API_KEY=
GEMINI_API_KEY=
PORT=3001
# Browser origins allowed to call the proxy and the Lab. Add your Pages origin.
PIXELSCOPE_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,https://swissmarley.github.io
# Optional Lab configuration. No downloads unless explicitly enabled.
PIXELSCOPE_LAB_MODEL=stabilityai/sd-turbo
PIXELSCOPE_ALLOW_MODEL_DOWNLOAD=0
